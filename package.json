{
  "name": "design-agent-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "空间设计智能体桌面工作台（自定义 API 纯净版）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:runtime": "tsx --tsconfig tsconfig.node.json scripts/verify-runtime.ts",
    "test:plan": "node scripts/run-plan-tests.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "verify:resources": "node scripts/check-resources.mjs --verify",
    "test:resources": "node scripts/test-resources.mjs",
    "pack:resources": "node scripts/pack-resources.mjs",
    "fetch:resources": "node scripts/fetch-resources.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "dist:win": "npm run build:runtime && npm run build && electron-builder --win --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.0",
    "@langchain/core": "^1.1.0",
    "@langchain/openai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@types/three": "^0.187.0",
    "assimpjs": "^0.0.10",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.3.0",
    "onnxruntime-node": "^1.31.1",
    "openskp": "^1.3.0",
    "pdfjs-dist": "^6.5.438",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rhino3dm": "^8.35.0",
    "three": "^0.187.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
