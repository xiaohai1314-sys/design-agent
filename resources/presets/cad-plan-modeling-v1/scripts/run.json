{
  "pack": "cad-plan-modeling-v1",
  "version": "1.0.0",
  "host": "cad",
  "connector": "multicad",
  "purpose": "住宅两室两厅户型平面种子图：打开副本 → 复核 → 另存 DWG → 按任务绘制/修改 → 再复核 → 交付。适用于图转CAD、平立剖深化、图纸检查整理、二维构件绘制等 CAD 向任务的起始基线。",
  "seed": {
    "dxf": "seed/plan.dxf",
    "format": "DXF R2010，单位 mm，几何 1:1 实测",
    "notes": "notes/dimension-audit.md",
    "policy": "种子原件只读：先复制到本轮输出目录再打开。包内不附 DWG——在 CAD 中打开 DXF 后另存为 DWG 即为工作文件（比第三方转换的 DWG 可靠）。"
  },
  "operations": [
    {
      "step": 1,
      "op": "list-documents",
      "detail": "用 multicad 列出当前已打开的文档，仅记录名称与路径，不关闭、不切换修改任何已有文档。"
    },
    {
      "step": 2,
      "op": "prepare-output-dir",
      "detail": "在当前工作区下新建唯一输出目录（例如 cad-output/<年月日-时分秒>/），把 seed/plan.dxf 复制进去。"
    },
    {
      "step": 3,
      "op": "open-copy",
      "detail": "用 multicad 打开输出目录中的 plan.dxf 副本；严禁用预置包目录内的种子原件作为编辑对象。"
    },
    {
      "step": 4,
      "op": "verify-seed",
      "detail": "导出数据复核副本：图层须包含 validation.requiredLayers 全部；DIMENSION 计数须等于 validation.expectedDimensions；总尺寸须为 X 11400 × Y 9000。任一不符，停下并向用户报告差异，不要带病继续。"
    },
    {
      "step": 5,
      "op": "save-as-dwg",
      "detail": "把副本另存为同目录 plan.dwg，后续全部编辑都在该 DWG 上进行。"
    },
    {
      "step": 6,
      "op": "task-work",
      "detail": "执行本轮任务要求的绘制/修改（描图转绘、深化、构件绘制等）：新图元放对应 A-* 图层；新增标注用 ARCHDIM 样式且必须为实测值，禁止手工填写或改写标注文字。"
    },
    {
      "step": 7,
      "op": "verify-result",
      "detail": "再次导出数据复核：图层齐全；未被任务改动的尺寸链仍闭合（见 validation.chains）；房间面积与 validation.rooms 一致（任务有意改动处须逐项说明）。"
    },
    {
      "step": 8,
      "op": "deliver",
      "detail": "用 deliver 交付输出目录中的 DWG（按需附 DXF / 截图），并文字汇报两次复核的结果。"
    }
  ],
