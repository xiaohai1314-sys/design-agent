    { "type": "living", "min_mm": 900, "min_height_mm": 2000, "clause": "GB 50096-2011 第 5.8.7 条", "text": "起居室（厅）门洞口宽度不应小于 0.90m" },
    { "type": "bedroom", "min_mm": 900, "min_height_mm": 2000, "clause": "GB 50096-2011 第 5.8.7 条", "text": "卧室门洞口宽度不应小于 0.90m" },
    { "type": "kitchen", "min_mm": 800, "min_height_mm": 2000, "clause": "GB 50096-2011 第 5.8.7 条", "text": "厨房门洞口宽度不应小于 0.80m" },
    { "type": "bathroom", "min_mm": 700, "min_height_mm": 2000, "clause": "GB 50096-2011 第 5.8.7 条", "text": "卫生间门洞口宽度不应小于 0.70m" },
    { "type": "balcony", "min_mm": 700, "min_height_mm": 2000, "clause": "GB 50096-2011 第 5.8.7 条", "text": "阳台门（单扇）洞口宽度不应小于 0.70m" }
  ],
  "height": [
    { "type": "storey", "min_mm": 2800, "level": "should", "clause": "GB 50096-2011 第 5.5.1 条", "text": "住宅层高宜为 2.80m" },
    { "type": "clear_main", "min_mm": 2400, "level": "must", "clause": "GB 50096-2011 第 5.5.2 条", "text": "卧室、起居室（厅）的室内净高不应低于 2.40m" },
