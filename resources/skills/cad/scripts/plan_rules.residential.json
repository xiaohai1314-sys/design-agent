    { "type": "bedroom_single", "min_m2": 5.0, "level": "must", "clause": "GB 50096-2011 第 5.2.1 条", "text": "单人卧室使用面积不应小于 5㎡" },
    { "type": "living", "min_m2": 10.0, "level": "must", "clause": "GB 50096-2011 第 5.2.2 条", "text": "起居室（厅）使用面积不应小于 10㎡" },
